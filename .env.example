# Backend environment variables for shorter-link-backend
# Example MongoDB connection string: mongodb://localhost:27017/shorter-link
# or mongodb+srv://<user>:<password>@cluster.example.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_CONNECTIONSTRING=xxx

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Short URL generation settings
# NOTE: this value is treated as minutes, not days
SHORT_URL_LENGTH=6
SHORT_URL_EXPIRATION_DAYS=3

JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

DAILY_SHORTEN_LIMIT=10
MAX_GROUPS_COUNT=5
MAX_MEMBERS_PER_GROUP=10
MAX_LINKS_PER_GROUP=20

# Default admin seed account
ADMIN_USERNAME=admin
ADMIN_FULLNAME=xxx
ADMIN_PASSWORD=xxx

# Redis Cloud
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=your_redis_host_here
REDIS_PORT=13166

# Notification Provider: 'websocket' (legacy) | 'quicknotify'
NOTIFICATION_PROVIDER=websocket

# WebSocket server URL for notifications (used when NOTIFICATION_PROVIDER=websocket)
WS_URL=http://localhost:3002

# QuickNotify configuration (used when NOTIFICATION_PROVIDER=quicknotify)
QUICKNOTIFY_URL=http://localhost:8080
QUICKNOTIFY_JWT_SECRET=your_quicknotify_shared_secret_here

# QuickBite Identity SSO Configuration
IDENTITY_URL=https://identity.com
OIDC_CLIENT_ID=portal
OIDC_SCOPE=example scope
GOOGLE_CLIENT_ID=test.googleusercontent.com
